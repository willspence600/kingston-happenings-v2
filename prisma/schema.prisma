// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NOTE: User authentication is handled by Supabase Auth + profiles table
// The profiles table is created via supabase-setup.sql, not Prisma
// User IDs in this schema reference Supabase Auth UUIDs stored as strings

model Venue {
  id            String   @id @default(cuid())
  name          String
  address       String
  neighborhood  String?
  website       String?
  imageUrl      String?
  coverImageUrl String?
  status        String   @default("approved") // pending, approved, rejected
  promotionTier String   @default("standard") // standard, promoted, featured
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  events Event[]
  series EventSeries[]
}

model EventSeries {
  id                String   @id @default(cuid())
  title             String
  description       String
  startTime         String
  endTime           String?
  price             String?
  ticketUrl         String?
  imageUrl          String?
  isAllDay          Boolean  @default(false)
  status            String   @default("pending") // pending, approved, rejected
  recurrencePattern String // weekly, biweekly, monthly
  recurrenceDays    Int[] // 0-6, supports multiple weekdays (e.g. [1,3] = Mon & Wed)
  seriesStartDate   String // YYYY-MM-DD, first occurrence
  seriesEndDate     String? // YYYY-MM-DD, null = open-ended
  venueId           String
  venue             Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  submittedById     String?
  categories        EventSeriesCategory[]
  occurrences       Event[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model EventSeriesCategory {
  id       String      @id @default(cuid())
  name     String
  series   EventSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesId String

  @@unique([seriesId, name])
}

model Event {
  id          String  @id @default(cuid())
  title       String
  description String
  date        String // YYYY-MM-DD format
  startTime   String // HH:MM format
  endTime     String?
  price       String?
  ticketUrl   String?
  imageUrl    String?
  featured    Boolean @default(false)
  status      String  @default("pending") // pending, approved, rejected, cancelled
  sortOrder   Int? // For admin-controlled sorting (especially for food & drink specials)
  isAllDay    Boolean @default(false)

  // Series linkage (recurring events)
  seriesId            String?
  series              EventSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  detachedFromSeries  Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  venue         Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  venueId       String
  // submittedById stores Supabase user ID (UUID), not Prisma User ID (CUID)
  // We store it as a plain string without foreign key constraint since Supabase users
  // don't exist in the Prisma User table
  submittedById String?
  categories    EventCategory[]
  likes         Like[]
}

model EventCategory {
  id      String @id @default(cuid())
  name    String // concert, food-deal, trivia, etc.
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  @@unique([eventId, name])
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // userId stores Supabase user ID (UUID), not Prisma User ID (CUID)
  // We store it as a plain string without foreign key constraint since Supabase users
  // don't exist in the Prisma User table
  userId  String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  @@unique([userId, eventId])
}
